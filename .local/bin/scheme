}

# Preset schemes: seed colour per flavour/mode plus literal terminal/alias
# palettes taken from each upstream. Add new presets here (palette values
# from the upstream project, never from caelestia's GPL data files).
# "terms"/"aliases" override the harmonised defaults when given.
PRESETS = {
    # https://catppuccin.com/palette (MIT)
