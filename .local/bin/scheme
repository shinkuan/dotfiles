#!/usr/bin/env python3
"""Colour scheme generator.

Generates a Material You palette (via materialyoucolor, the Python port of
Google's Material Color Utilities) plus the extended colour names the rest of
the desktop consumes (term0-15, catppuccin-style aliases, KDE semantic
colours, overlays, success roles), and renders every consumer template.

Subcommands:
    scheme set [--name N] [--flavour F] [--mode M] [--variant V] [--random]
    scheme sync            regenerate colours + templates for current settings
    scheme get [--json]    show current settings
    scheme list            show available names / flavours / modes / variants

All paths derive from the XDG base dirs (XDG_CONFIG_HOME / XDG_STATE_HOME /
XDG_CACHE_HOME with spec fallbacks), so a nested test session that points
those at a worktree stays fully isolated.

Outputs:
    $XDG_STATE_HOME/scheme/scheme.json        settings + full colour map
    $XDG_STATE_HOME/scheme/colours.json       same (shell hot-loads this)
    $XDG_CONFIG_HOME/hypr/scheme/current.lua  lua module for the hypr config
    $XDG_CONFIG_HOME/hypr/scheme/current.conf hyprlang vars for hyprlock
    $XDG_CONFIG_HOME/qt6ct/colors/scheme.colors
    $XDG_CONFIG_HOME/gtk-3.0/gtk.css, gtk-4.0/gtk.css
    $XDG_CACHE_HOME/scheme/foot.ini           terminal palette (see below)
    $XDG_CACHE_HOME/scheme/sequences.txt      OSC colour sequences

The terminal palette source is a config switch
($XDG_CONFIG_HOME/scheme/config.json, {"terminal": {"source": ...}}):
"hellwal" (default; the wallpaper script copies hellwal's output into place)
or "m3" (rendered here from term0-15).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import random
import sys
from pathlib import Path

# ---------------------------------------------------------------- XDG paths


def _xdg(var: str, fallback: str) -> Path:
    value = os.environ.get(var)
    return Path(value) if value else Path.home() / fallback


CONFIG_HOME = _xdg("XDG_CONFIG_HOME", ".config")
STATE_HOME = _xdg("XDG_STATE_HOME", ".local/state")
CACHE_HOME = _xdg("XDG_CACHE_HOME", ".cache")

STATE_DIR = STATE_HOME / "scheme"
CACHE_DIR = CACHE_HOME / "scheme"
WALL_STATE_DIR = STATE_HOME / "wallpaper"
SCHEME_JSON = STATE_DIR / "scheme.json"
COLOURS_JSON = STATE_DIR / "colours.json"
CONFIG_JSON = CONFIG_HOME / "scheme" / "config.json"

DEFAULTS = {"name": "dynamic", "flavour": "default", "mode": "dark", "variant": "content"}

VARIANTS = ["tonalspot", "vibrant", "expressive", "fidelity", "fruitsalad",
            "monochrome", "neutral", "rainbow", "content"]

# ------------------------------------------------------------- anchor data
# Data, not code: terminal anchors are Monokai-style (light) / Gruvbox (dark)
# palette values, named-colour anchors are the Catppuccin latte/mocha accents,
# k-colours are KDE Breeze's semantic colours. Each list is harmonised toward
# the generated palette at render time.

