SUCCESS = {
    "light": {"success": "4F6354", "onSuccess": "FFFFFF",
              "successContainer": "D1E8D5", "onSuccessContainer": "0C1F13"},
    "dark": {"success": "B5CCBA", "onSuccess": "213528",
