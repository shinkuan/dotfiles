#!/usr/bin/env bash
# swappy -> satty shim.
#
# caelestia hardcodes `swappy` in two pacman-managed files:
#   /etc/xdg/quickshell/caelestia/modules/areapicker/Picker.qml   (region capture)
#   /usr/lib/python3*/site-packages/caelestia/subcommands/screenshot.py  (CLI)
# Patching either gets wiped on the next package update, so intercept on PATH
# instead. The real swappy is still available at /usr/bin/swappy.

set -euo pipefail

file=""
out=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--file)
            file="${2-}"; shift 2 ;;
        -o|--output-file)
            out="${2-}"; shift 2 ;;
        -v|--version|-h|--help|--help-*)
            exec /usr/bin/swappy "$@" ;;
        *)
            shift ;;
    esac
done

# Nothing we know how to translate - hand back to the real swappy.
[[ -n $file ]] || exec /usr/bin/swappy "$@"

if [[ -z $out ]]; then
    out="$HOME/Pictures/Screenshots/%Y%m%d-%H%M%S.png"
    mkdir -p "$HOME/Pictures/Screenshots"
fi

exec satty -f "$file" -o "$out" --copy-command wl-copy --early-exit all
