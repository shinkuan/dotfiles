[Unit]
Description=Cap NVIDIA GPU clocks in the power-saver profile
After=power-profiles-daemon.service

[Service]
ExecStart=/usr/local/bin/power-saver-gpu
ExecStopPost=/usr/bin/nvidia-smi -rgc
ExecStopPost=/usr/bin/nvidia-smi -rmc
Restart=on-failure

[Install]
# Not multi-user.target: ppd's own unit is After=multi-user.target, so with the
# After= above that would be an ordering cycle and systemd drops this job at boot.
WantedBy=graphical.target
