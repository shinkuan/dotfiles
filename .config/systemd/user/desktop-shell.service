[Unit]
Description=Desktop shell (quickshell)
Documentation=https://quickshell.org/docs/
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=QSG_RENDER_LOOP=threaded
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_IM_MODULE=fcitx
Environment=XMODIFIERS=@im=fcitx
# Qt reads its frame pacing from the primary screen once, at startup: started
# before the compositor has advertised an output it falls back to a 16 ms timer
# (62 fps) and never picks the real refresh rate up again. Wait for a monitor.
ExecStartPre=-/usr/bin/timeout 10 /bin/sh -c 'until hyprctl monitors 2>/dev/null | grep -q "@[1-9]"; do sleep 0.1; done'
ExecStart=/usr/bin/qs -c desktop
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
