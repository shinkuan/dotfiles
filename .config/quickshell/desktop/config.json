{
    "animation": {
        "scale": 0.8
    },
    "appearance": {
        "style": "rim"
    },
    "bar": {
        "pinThreshold": 20,
        "showResources": true,
        "width": 44,
        "position": "left"
    },
    "border": {
        "rounding": 25,
        "thickness": 10
    },
    "brightness": {
        "external": true,
        "step": 5
    },
    "desktopClock": {
        "margin": 48,
        "position": "bottom-right"
    },
    "idle": {
        "inhibitWhenAudio": true,
        "joystickHold": 60
    },
    "kgrid": {
        "hideDelay": 1000,
        "osd": true
    },
    "launcher": {
        "actionPrefix": ">",
        "actions": [
            {
                "command": [
                    "@scheme"
                ],
                "description": "Change the colour scheme",
                "icon": "palette",
                "name": "Scheme"
            },
            {
                "command": [
                    "@variant"
                ],
                "description": "Change the scheme variant",
                "icon": "colors",
                "name": "Variant"
            },
            {
                "command": [
                    "@wallpaper"
                ],
                "description": "Pick a wallpaper",
                "icon": "image",
                "name": "Wallpaper"
            },
            {
                "command": [
                    "@style"
                ],
                "description": "Switch the shell's visual direction",
                "icon": "style",
                "name": "Style"
            },
            {
                "command": [
                    "wallpaper",
                    "-r"
                ],
                "description": "Switch to a random wallpaper",
                "icon": "casino",
                "name": "Random wallpaper"
            },
            {
                "command": [
                    "scheme",
                    "set",
                    "--mode",
                    "light"
                ],
                "description": "Switch the scheme to light mode",
                "icon": "light_mode",
                "name": "Light"
            },
            {
                "command": [
                    "scheme",
                    "set",
                    "--mode",
                    "dark"
                ],
                "description": "Switch the scheme to dark mode",
                "icon": "dark_mode",
                "name": "Dark"
            },
            {
                "command": [
                    "hyprctl",
                    "eval",
                    "_G.toggle_darkwindow_shader()"
                ],
                "description": "Toggle the VS Code transparency shader",
                "icon": "blur_on",
                "name": "VS Code shader"
            },
            {
                "command": [
                    "@config"
                ],
                "description": "Open the shell config",
                "icon": "settings",
                "name": "Settings"
            },
            {
                "command": [
                    "sh",
                    "-c",
                    "pidof hyprlock || hyprlock"
                ],
                "description": "Lock the session",
                "icon": "lock",
                "name": "Lock"
            },
            {
                "command": [
                    "systemctl",
                    "suspend"
                ],
                "description": "Suspend the system",
                "icon": "bedtime",
                "name": "Sleep"
            },
            {
                "command": [
                    "hyprctl",
                    "dispatch",
                    "hl.dsp.exit()"
                ],
                "dangerous": true,
                "description": "End the Hyprland session",
                "icon": "logout",
                "name": "Logout"
            },
            {
                "command": [
                    "systemctl",
                    "reboot"
                ],
                "dangerous": true,
                "description": "Reboot the system",
                "icon": "restart_alt",
                "name": "Reboot"
            },
            {
                "command": [
                    "systemctl",
                    "poweroff"
                ],
                "dangerous": true,
                "description": "Shut the system down",
                "icon": "power_settings_new",
                "name": "Shutdown"
            }
        ],
        "calcPrefix": "=",
        "clipPrefix": ";",
        "emojiFile": "/usr/share/unicode/emoji/emoji-test.txt",
        "emojiPrefix": ":",
        "fuzzy": true,
        "maxResults": 9,
        "showDangerous": false
    },
    "notifications": {
        "criticalTimeout": 0,
        "maxHistory": 200,
        "timeout": 5000,
        "width": 380
    },
    "osd": {
        "hideDelay": 2000
    },
    "popouts": {
        "listHeight": 320,
        "showOnHover": true,
        "width": 340
    },
    "resources": {
        "interval": 2000
    },
    "screenshot": {
        "directory": "Pictures/Screenshots"
    }
}
