{
    "appearance": {
        "style": "rim"
    },
    "animation": {
        "scale": 0.8
    },
    "border": {
        "thickness": 10,
        "rounding": 25
    },
    "bar": {
        "width": 44,
        "pinThreshold": 20,
        "showResources": true
    },
    "popouts": {
        "showOnHover": true,
        "width": 340,
        "listHeight": 320
    },
    "osd": {
        "hideDelay": 2000
    },
    "kgrid": {
        "osd": true,
        "hideDelay": 1000
    },
    "desktopClock": {
        "position": "bottom-right",
        "margin": 48
    },
    "notifications": {
        "timeout": 5000,
        "criticalTimeout": 0,
        "maxHistory": 200,
        "width": 380
    },
    "idle": {
        "inhibitWhenAudio": true,
        "joystickHold": 60
    },
    "launcher": {
        "maxResults": 9,
        "actionPrefix": ">",
        "calcPrefix": "=",
        "clipPrefix": ";",
        "emojiPrefix": ":",
        "fuzzy": true,
        "showDangerous": false,
        "actions": [
            {
                "name": "Scheme",
                "icon": "palette",
                "description": "Change the colour scheme",
                "command": [
                    "@scheme"
                ]
            },
            {
                "name": "Variant",
                "icon": "colors",
                "description": "Change the scheme variant",
                "command": [
                    "@variant"
                ]
            },
            {
                "name": "Wallpaper",
                "icon": "image",
                "description": "Pick a wallpaper",
                "command": [
                    "@wallpaper"
                ]
            },
            {
                "name": "Random wallpaper",
                "icon": "casino",
                "description": "Switch to a random wallpaper",
                "command": [
                    "wallpaper",
                    "-r"
                ]
            },
            {
                "name": "Light",
                "icon": "light_mode",
                "description": "Switch the scheme to light mode",
                "command": [
                    "scheme",
                    "set",
                    "--mode",
                    "light"
                ]
            },
            {
                "name": "Dark",
                "icon": "dark_mode",
                "description": "Switch the scheme to dark mode",
                "command": [
                    "scheme",
                    "set",
                    "--mode",
                    "dark"
                ]
            },
            {
                "name": "VS Code shader",
                "icon": "blur_on",
                "description": "Toggle the VS Code transparency shader",
                "command": [
                    "hyprctl",
                    "eval",
                    "_G.toggle_darkwindow_shader()"
                ]
            },
            {
                "name": "Settings",
                "icon": "settings",
                "description": "Open the shell config",
                "command": [
                    "@config"
                ]
            },
            {
                "name": "Lock",
                "icon": "lock",
                "description": "Lock the session",
                "command": [
                    "sh",
                    "-c",
                    "pidof hyprlock || hyprlock"
                ]
            },
            {
                "name": "Sleep",
                "icon": "bedtime",
                "description": "Suspend the system",
                "command": [
                    "systemctl",
                    "suspend"
                ]
            },
            {
                "name": "Logout",
                "icon": "logout",
                "description": "End the Hyprland session",
                "command": [
                    "hyprctl",
                    "dispatch",
                    "hl.dsp.exit()"
                ],
                "dangerous": true
            },
            {
                "name": "Reboot",
                "icon": "restart_alt",
                "description": "Reboot the system",
                "command": [
                    "systemctl",
                    "reboot"
                ],
                "dangerous": true
            },
            {
                "name": "Shutdown",
                "icon": "power_settings_new",
                "description": "Shut the system down",
                "command": [
                    "systemctl",
                    "poweroff"
                ],
                "dangerous": true
            }
        ]
    },
    "screenshot": {
        "directory": "Pictures/Screenshots"
    },
    "resources": {
        "interval": 2000
    },
    "brightness": {
        "external": true,
        "step": 5
    }
}
