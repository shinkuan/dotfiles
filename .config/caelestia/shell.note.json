{
    "idle": {
      "lockBeforeSleep": false,
      "inhibitWhenAudio": true,
      "timeouts": [
        {
          "idleAction": "'hl.dsp.exec_cmd(\"hyprlock\")'",
          "timeout": 300
        },
        {
          "idleAction": "'hl.dsp.dpms({ action = \"off\" })'", 
          "timeout": 600
        },
        {
          "idleAction": "exec systemctl suspend",
          "timeout": 3600
        }
      ]
    }
}