// Load with --load-config examples/3.jsonc

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/ascii_2.txt",
        // "width": 65,           // Width in characters (for image logos)
        // "height": 35,          // Height in characters (for image logos)
        "padding": {
            "top": 0,
            "left": 0
        }
    },
    "display": {
        "size": {
            "binaryPrefix": "si"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "packages",
        "cpuusage",
        "memory",
        "swap",
        {
            "type": "disk",
            "folders": "/:/home:/boot:/efi"
        },
        "wifi",
        "uptime",
        "datetime"
